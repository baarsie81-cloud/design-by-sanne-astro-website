---
const projects = [
  {
    label: "Website",
    title: "Life Line Trainingen",
    text: "Een website waarin trainingen, kennis en contactmogelijkheden overzichtelijk samenkomen.",
    image: "/assets/designbysanne/project-visuals/life-line-trainingen-website.webp",
    alt: "Homepage van de website van Life Line Trainingen",
    href: "/websites/",
  },
  {
    label: "Marketing & strategie",
    title: "Van richting naar campagne",
    text: "Van campagne en content tot visuele communicatie die past bij je organisatie en doelgroep.",
    image: "/assets/designbysanne/project-visuals/marketing-strategie-stock.webp",
    alt: "Overlegtafel met laptops, analyses en campagneplanning",
    href: "/diensten/",
  },
  {
    label: "Digitale oplossing",
    title: "Verlof- en overurendashboard",
    text: "Een dashboard voor verlof, ziekte, overuren, aanvragen en medewerkersbeheer.",
    image: "/assets/designbysanne/project-visuals/verlof-overuren-dashboard.webp",
    alt: "Dashboard voor verlof, ziekte, overuren en medewerkersbeheer",
    href: "/digitale-oplossingen/",
  },
];
---

<section class="showcase" id="werk" aria-labelledby="showcase-title">
  <div class="showcase-heading">
    <p class="showcase-kicker">Wat ik maak</p>
    <h2 id="showcase-title">Van een sterk verhaal tot een slimme oplossing.</h2>
    <p>Bekijk in één oogopslag hoe communicatie, websites en digitale toepassingen concreet vorm kunnen krijgen.</p>
  </div>

  <div class="showcase-grid">
    {
      projects.map((project, index) => (
        <article class:list={["showcase-card", index === 0 && "showcase-card-wide"]}>
          <a href={project.href} aria-label={`${project.title} Meer bekijken`}>
            <figure>
              <img src={project.image} alt={project.alt} loading={index === 0 ? "eager" : "lazy"} />
            </figure>
            <div class="showcase-copy">
              <span>{project.label}</span>
              <h3>{project.title}</h3>
              <p>{project.text}</p>
              <strong>Meer bekijken <span aria-hidden="true">→</span></strong>
            </div>
          </a>
        </article>
      ))
    }
  </div>

</section>

<style>
  .showcase {
    padding: 94px 24px;
    background: #ffffff;
  }

  .showcase-heading {
    width: min(860px, 100%);
    margin: 0 auto 42px;
    text-align: center;
  }

  .showcase-kicker {
    margin: 0 0 14px;
    color: #9a4d42;
    font-size: 15px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .showcase-heading h2 {
    margin: 0 0 18px;
    color: #1f2a2f;
    font-size: 46px;
    line-height: 1.08;
    font-weight: 900;
  }

  .showcase-heading > p:last-child {
    margin: 0;
    color: #586167;
    font-size: 19px;
    line-height: 1.65;
  }

  .showcase-grid {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .showcase-card {
    overflow: hidden;
    border: 1px solid rgba(32, 40, 47, 0.12);
    border-radius: 8px;
    background: #f5f4ef;
    box-shadow: 0 18px 40px rgba(32, 40, 47, 0.08);
  }

  .showcase-card-wide {
    grid-column: 1 / -1;
  }

  .showcase-card a {
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
    color: inherit;
    text-decoration: none;
  }

  .showcase-card-wide a {
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    grid-template-rows: none;
  }

  .showcase-card figure {
    position: relative;
    margin: 0;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #20282f;
  }

  .showcase-card-wide figure {
    aspect-ratio: 2 / 1;
  }

  .showcase-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 240ms ease;
  }

  .showcase-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
  }

  .showcase-copy > span {
    margin-bottom: 20px;
    color: #9a4d42;
    font-size: 14px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .showcase-copy h3 {
    margin: 0 0 14px;
    color: #20282f;
    font-size: 27px;
    line-height: 1.16;
  }

  .showcase-copy p {
    margin: 0 0 24px;
    color: #586167;
    line-height: 1.62;
  }

  .showcase-copy strong {
    margin-top: auto;
    color: #627727;
  }

  @media (max-width: 860px) {
    .showcase-card-wide a {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
  }

  @media (max-width: 700px) {
    .showcase {
      padding: 68px 18px;
    }

    .showcase-heading h2 {
      font-size: 31px;
      line-height: 1.14;
    }

    .showcase-heading > p:last-child {
      font-size: 17px;
    }

    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .showcase-card-wide {
      grid-column: auto;
    }

    .showcase-copy {
      padding: 24px;
    }

    .showcase-copy h3 {
      font-size: 24px;
    }
  }
</style>
