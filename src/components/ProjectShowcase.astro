---
const projects = [
  {
    label: "Marketing & strategie",
    title: "Van richting naar campagne",
    image: "/assets/designbysanne/project-visuals/marketing-strategie-sanne-collage.jpg",
    alt: "Sanne van Design by Sanne voor marketing en strategie",
    href: "/diensten/",
    layout: "main",
  },
  {
    label: "Websiteproject",
    title: "Life Line Trainingen",
    image: "/assets/designbysanne/project-visuals/life-line-trainingen-website.webp",
    alt: "Homepage van de website van Life Line Trainingen",
    href: "/websites/",
    layout: "secondary",
  },
  {
    label: "Digitale oplossing",
    title: "Verlof- en overurendashboard",
    image: "/assets/designbysanne/project-visuals/verlof-overuren-dashboard.webp",
    alt: "Dashboard voor verlof, ziekte, overuren en medewerkersbeheer",
    href: "/digitale-oplossingen/",
    layout: "secondary",
  },
];
---

<section class="showcase" id="werk" aria-labelledby="showcase-title">
  <div class="showcase-heading">
    <p class="showcase-kicker">Wat ik maak</p>
    <h2 id="showcase-title">Van een sterk verhaal tot een slimme oplossing.</h2>
    <p>Bekijk in één oogopslag hoe communicatie, websites en digitale toepassingen concreet vorm kunnen krijgen.</p>
  </div>

  <div class="showcase-grid">
    {
      projects.map((project, index) => (
        <article class:list={["showcase-card", `showcase-card-${project.layout}`]}>
          <a href={project.href} aria-label={`Bekijk ${project.title}`}>
            <figure>
              <img src={project.image} alt={project.alt} loading={index === 0 ? "eager" : "lazy"} />
              <figcaption>
                <span>{project.label}</span>
                <strong>{project.title}</strong>
              </figcaption>
            </figure>
          </a>
        </article>
      ))
    }
  </div>

  <div class="showcase-guidance">
    <div>
      <span>Wat past bij jouw vraag?</span>
      <p>Soms begint dat bij een heldere boodschap, soms bij een website of een slimmer proces. Ik help je bepalen welke stap nu het meeste oplevert.</p>
    </div>
    <a href="/diensten/">Bekijk mijn diensten <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .showcase {
    padding: 94px 24px;
    background: #ffffff;
  }

  .showcase-heading {
    width: min(860px, 100%);
    margin: 0 auto 42px;
    text-align: center;
  }

  .showcase-kicker {
    margin: 0 0 14px;
    color: #9a4d42;
    font-size: 15px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .showcase-heading h2 {
    margin: 0 0 18px;
    color: #1f2a2f;
    font-size: 46px;
    line-height: 1.08;
    font-weight: 900;
  }

  .showcase-heading > p:last-child {
    margin: 0;
    color: #586167;
    font-size: 19px;
    line-height: 1.65;
  }

  .showcase-grid {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .showcase-card {
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(32, 40, 47, 0.12);
    border-radius: 8px;
    background: #20282f;
    box-shadow: 0 20px 50px rgba(32, 40, 47, 0.12);
  }

  .showcase-card-main {
    grid-row: 1 / -1;
    height: 100%;
  }

  .showcase-card-secondary {
    aspect-ratio: 16 / 10;
  }

  .showcase-card a,
  .showcase-card figure {
    width: 100%;
    height: 100%;
  }

  .showcase-card a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .showcase-card figure {
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .showcase-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .showcase-card-secondary img {
    object-fit: contain;
    background: #ffffff;
  }

  .showcase-card figcaption {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    padding: 14px 52px 14px 16px;
    border-radius: 7px;
    background: rgba(24, 32, 37, 0.9);
    color: #ffffff;
    backdrop-filter: blur(7px);
  }

  .showcase-card figcaption::after {
    content: "→";
    position: absolute;
    top: 50%;
    right: 18px;
    color: #dca326;
    font-size: 20px;
    font-weight: 900;
    transform: translateY(-50%);
  }

  .showcase-card figcaption span,
  .showcase-card figcaption strong {
    display: block;
  }

  .showcase-card figcaption span {
    margin-bottom: 5px;
    color: #dca326;
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .showcase-card figcaption strong {
    font-size: 16px;
    line-height: 1.35;
  }

  .showcase-guidance {
    width: min(1120px, 100%);
    margin: 30px auto 0;
    padding-top: 26px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 36px;
    align-items: center;
    border-top: 1px solid rgba(32, 40, 47, 0.14);
  }

  .showcase-guidance > div {
    max-width: 760px;
  }

  .showcase-guidance > div > span {
    display: block;
    margin-bottom: 7px;
    color: #9a4d42;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .showcase-guidance p {
    margin: 0;
    color: #586167;
    font-size: 17px;
    line-height: 1.62;
  }

  .showcase-guidance > a {
    min-height: 50px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid #627727;
    border-radius: 7px;
    color: #627727;
    font-weight: 900;
    text-decoration: none;
  }

  .showcase-guidance > a:hover,
  .showcase-guidance > a:focus-visible {
    background: #627727;
    color: #ffffff;
  }

  @media (max-width: 980px) {
    .showcase-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .showcase-card-main {
      grid-row: auto;
    }

    .showcase-card-secondary {
      aspect-ratio: 2 / 1;
    }
  }

  @media (max-width: 700px) {
    .showcase {
      padding: 68px 18px;
    }

    .showcase-heading {
      margin-bottom: 32px;
    }

    .showcase-heading h2 {
      font-size: 31px;
      line-height: 1.14;
    }

    .showcase-heading > p:last-child {
      font-size: 17px;
    }

    .showcase-grid {
      gap: 14px;
    }

    .showcase-card-main,
    .showcase-card-secondary {
      aspect-ratio: 4 / 3;
    }

    .showcase-card figcaption {
      left: 12px;
      right: 12px;
      bottom: 12px;
      padding: 12px 48px 12px 14px;
    }

    .showcase-guidance {
      margin-top: 24px;
      padding-top: 22px;
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .showcase-guidance p {
      font-size: 16px;
    }

    .showcase-guidance > a {
      width: 100%;
    }
  }
</style>
